generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())
  plainPassword String?
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  barcode     String?  @unique
  price       Float
  stock       Int      @default(0)
  category    String?
  createdAt   DateTime @default(now())
  saleItems SaleItem[]
}

model Customer {
  id         Int      @id @default(autoincrement())
  company    String
  branch     String
  balance    Float
  taxNumber  String
  address    String
  createdAt  DateTime @default(now())
  sales Sale[]
  balanceLogs BalanceLog[]
}

model BalanceLog {
  id          Int      @id @default(autoincrement())

  customerId  Int

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type        String
  amount      Float
  description String?

  createdAt   DateTime @default(now())
}

model Sale {
  id          Int        @id @default(autoincrement())

  customerId  Int?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  totalPrice  Float

  createdAt   DateTime   @default(now())

  items       SaleItem[]
  customerName String?
  branchName   String?
}

model SaleItem {
  id          Int      @id @default(autoincrement())

  saleId      Int
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId   Int?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  quantity    Float
  unit        String

  unitPrice   Float
  totalPrice  Float

  withVat     Boolean

  createdAt   DateTime @default(now())

  productName String?
}